# Example server blocks. Replace example.com and the backend (127.0.0.1:3000) once the site's stack is integrated.

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;   # login / sign-up / reset
limit_req_zone $binary_remote_addr zone=submit:10m rate=5r/m;  # article and source submissions
server_tokens off;

# Public signing keys and signatures are readable by partners' tools from any origin (no credentials involved).
map $uri $pq_public {
    = /.well-known/pqsig-keys.json 1;
    ~\.sig\.json$                  1;
    default                        0;
}
map $pq_public $pq_corp { 1 cross-origin; default same-origin; }
map $pq_public $pq_acao { 1 "*";          default "";          }   # empty value = header not sent

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://example.com$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;
    root /var/www/site/public;

    include /etc/nginx/snippets/tls-pq.conf;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cross-Origin-Resource-Policy $pq_corp always;
    add_header Access-Control-Allow-Origin $pq_acao always;

    client_max_body_size 10m;

    # Defence in depth: key material must never be in the web root, but never serve it if it is.
    location ~* (\.secret\.json|\.env|\.git)(/|$) { return 404; }

    # Adjust paths to the real auth and submission routes.
    location ~ ^/account/(login|register|reset) { limit_req zone=auth burst=5 nodelay;   proxy_pass http://127.0.0.1:3000; }
    location ~ ^/(submit|account/submissions)   { limit_req zone=submit burst=3 nodelay; proxy_pass http://127.0.0.1:3000; }

    # Static files (verify page, keyset, signatures) straight from disk; everything else to the app.
    location / { try_files $uri $uri/ @app; }
    location @app {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Belt and braces: whatever the backend sets, cookies leave here Secure + HttpOnly + SameSite=Lax.
        proxy_cookie_flags ~ secure httponly samesite=lax;
    }
}
