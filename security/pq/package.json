{
  "name": "pq-integrity",
  "private": true,
  "type": "module",
  "description": "Post-quantum signing (ML-DSA-87 + Ed448) and sealing (ML-KEM-1024 + P-384 / AES-256-GCM) for articles, feeds and submissions.",
  "bin": {
    "pq": "./cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "build": "esbuild verify/verify.src.mjs --bundle --format=esm --minify --target=es2022 --outfile=verify/verify.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
